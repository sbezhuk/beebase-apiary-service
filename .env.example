# Copy to .env for local development: cp .env.example .env

# development | production
APP_ENV=development

# debug | info | warn | error
LOG_LEVEL=debug

HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# Used by the app.
DATABASE_URL=postgres://beebase:beebase@localhost:5433/beebase_apiary?sslmode=disable
DATABASE_CONNECT_TIMEOUT=5s

# Used by docker-compose to provision the postgres container.
POSTGRES_USER=beebase
POSTGRES_PASSWORD=beebase
POSTGRES_DB=beebase_apiary

# Used only by `make test-integration`, never by the app itself.
TEST_DATABASE_URL=postgres://beebase:beebase@localhost:5433/beebase_apiary_test?sslmode=disable

# Required: auth-service's public key endpoint, used to verify access
# tokens without ever holding a key that could mint one. For standalone
# `go run` against auth-service also running on the host:
AUTH_JWKS_URL=http://localhost:8081/.well-known/jwks.json
# `docker compose up` (via beebase-gateway) overrides this to the
# in-network auth-service address — you don't need to change it for that path.

# Required: hive-service's and media-service's base URLs. Deleting an
# apiary cascades to its hives (and, transitively, their inspections and
# media) and to media attached directly to the apiary.
HIVE_SERVICE_URL=http://localhost:8083
MEDIA_SERVICE_URL=http://localhost:8085
# `docker compose up` (via beebase-gateway) overrides both of the above
# to in-network addresses — you don't need to change them for that path.
